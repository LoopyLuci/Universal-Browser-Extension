{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnea.org/schemas/envelope/v1.json",
  "title": "DNEA Thin Client Envelope",
  "type": "object",
  "required": ["v", "id", "type", "ts", "src", "dst"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string" },
    "type": { "type": "string", "pattern": "^(dnea/|mod/)" },
    "ts": { "type": "string" },
    "src": { "type": "string" },
    "dst": { "type": "string" },
    "reply_to": { "type": "string" },
    "cap": { "type": "string" },
    "mod": { "type": "string" },
    "enc": { "enum": ["identity", "zstd", "br"], "default": "identity" },
    "ttl_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
    "payload": {},
    "err": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string", "maxLength": 512 },
        "retryable": { "type": "boolean", "default": false },
        "retry_after_ms": { "type": "integer", "minimum": 0 },
        "details": { "type": "object" },
        "cause": { "type": "string" }
      },
      "additionalProperties": true
    },
    "meta": { "type": "object" }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": true
}